---
// Lucide-style outline icons (ISC), drawn inline so the page needs no icon font.
interface Props {
  name: "star" | "heart";
}
const paths = {
  star: "M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z",
  heart:
    "M19.5 13.6 12 21l-7.5-7.4A4.9 4.9 0 0 1 12 6.9a4.9 4.9 0 0 1 7.5 6.7z",
};
const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
