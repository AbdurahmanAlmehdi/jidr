---
// From docs/design/screens/Landing.dc.html (D41, concept 8A).
import Icon from "./Icon.astro";
import { strings } from "../i18n";

const t = strings(Astro.currentLocale);
---

<section class="lp-sec" id="root">
  <span class="eyebrow">{t.root.eyebrow}</span>
  <h2 class="lp-h2">{t.root.title}</h2>
  <p class="lead">{t.root.lead}</p>
  <div class="rshow">
    <div class="rseq2" role="list">
      {t.root.stepsHtml.map((step, i) => (
        <div role="listitem"><Icon name="check" class="ic i16 ok" /><span set:html={step} /><span class="r">{t.root.step(i + 1)}</span></div>
      ))}
    </div>
    <div class="rres">
      <span class="rb p-root-strong shape-solid" lang="en"><Icon name="rooted" class="ic" />Rooted · Magisk 30.7</span>
      <span class="num mut" style="font-size:13px" lang="en">verified 14:02 · uid=0(root)</span>
      <p class="mut" style="margin:0;font-size:15px;line-height:24px">{t.root.failure}</p>
      <div class="banner p-warning"><Icon name="shieldAlert" class="ic i14" /><span>{t.root.integrity}</span></div>
    </div>
  </div>
</section>
