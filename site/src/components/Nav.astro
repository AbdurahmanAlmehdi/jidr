---
import symbol from "../../public/symbol.svg?raw";
import { links } from "../config";

// The brand symbol inline, so it takes the text colour (D39).
const mark = symbol.replace("<svg", '<svg class="mark" aria-hidden="true"');
---

<header class="lp-nav">
  <a class="logo" href="/"><Fragment set:html={mark} />Jidr <span lang="ar">جذر</span></a>
  <span class="grow"></span>
  <nav aria-label="Site">
    <a class="hide-sm" href="#features">Features</a>
    <a class="hide-sm" href="#root">Root</a>
  </nav>
  <a class="star" href={links.repo}><span><svg class="ic i14" viewBox="0 0 24 24" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>Star</span></a>
</header>
