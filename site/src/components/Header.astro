---
import Icon from "./Icon.astro";
import { links } from "../config";
---

<header class="header">
  <div class="container bar">
    <a class="wordmark" href="/">
      <span>Jidr</span>
      <span class="arabic" lang="ar" dir="rtl">جذر</span>
    </a>
    <nav aria-label="Main">
      <ul>
        <li><a href="#root">Root</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#honest">Limits</a></li>
      </ul>
    </nav>
    <a class="button" href={links.repo}><Icon name="star" />Star on GitHub</a>
  </div>
</header>

<style>
  .header {
    border-bottom: var(--jidr-border-width) solid var(--jidr-color-border-subtle);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--jidr-space-6);
    min-height: 64px;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: var(--jidr-space-2);
    color: var(--jidr-color-text-primary);
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .arabic {
    font-family: var(--jidr-font-arabic);
    font-weight: 600;
    color: var(--jidr-color-accent);
  }
  nav {
    margin-inline-start: auto;
  }
  ul {
    display: flex;
    gap: var(--jidr-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--jidr-color-text-secondary);
    font-size: var(--jidr-text-label);
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--jidr-color-text-primary);
  }
  @media (max-width: 640px) {
    nav {
      display: none;
    }
    .bar > .button {
      margin-inline-start: auto;
    }
  }
</style>
