---
// From docs/design/screens/Landing.dc.html (D41, concept 8A). The app is
// English-only (D33), so the shot stays English and LTR on both pages.
import { strings } from "../i18n";

const t = strings(Astro.currentLocale);
---

<div class="shot" dir="ltr" lang="en" role="img" aria-label={t.shotLabel}>
      <div class="tbar" inert><div class="lights"><span></span><span></span><span></span></div><div class="tab">Library</div><div class="tab on">Pixel-ish 6.1</div><div class="grow"></div></div>
      <div class="shot-b" inert>
        <div class="shot-side">
          <div class="j-dev on"><span class="l1"><span>Pixel-ish 6.1</span><span class="rb rb-s p-root-strong shape-solid"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>Rooted</span></span><span class="l2"><span class="st p-positive"><svg class="ic fill i8" viewBox="0 0 8 8" aria-hidden="true"><circle cx="4" cy="4" r="4"/></svg>Running · 2 h 14 m</span></span></div>
          <div class="j-dev"><span class="l1"><span>Tablet 11</span><span class="rb rb-s p-neutral shape-fill"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 17 6-6-6-6M12 19h8"/></svg>Shell</span></span><span class="l2"><span class="st mut">Stopped</span></span></div>
          <div class="j-dev"><span class="l1"><span>Play Store test</span><span class="rgrp"><span class="rb rb-s p-root-soft shape-outline">Full</span><span class="tag p-warning">Beta</span></span></span><span class="l2"><span class="st p-transition">Booting Android… 62%</span></span></div>
          <div class="j-dev"><span class="l1"><span>CI-runner-03</span><span class="rb rb-s shape-text-only">No root</span></span><span class="l2"><span class="st p-warning">Busy · in use by CLI</span></span></div>
        </div>
        <div class="shot-stage">
          <div class="bezel phone"><div class="screen" style="width:300px;height:560px;font-size:12.4px">
            <div class="ascr"><div class="a-h"><small>Delivering to</small><b>Martyrs' Square, Tripoli</b></div><div class="a-map"><svg viewBox="0 0 300 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M0 0H300V58C262 70 228 50 190 62S118 76 78 66 24 80 0 74Z" fill="#C9D7E0"/><path d="M0 132H300M58 70V240M148 64V240M236 58V240M0 196L300 168" stroke="#FFFFFF" stroke-width="8" fill="none"/><path d="M148 132L190 170 236 182" stroke="#1F4FB8" stroke-width="3" stroke-dasharray="6 5" fill="none"/><circle cx="148" cy="132" r="8" fill="#1F4FB8" stroke="#FFFFFF" stroke-width="3"/></svg></div><div class="a-card"><b>Courier is 4 min away</b><span>3 items · paid</span></div><div class="a-btn">Track order</div></div>
          </div></div>
        </div>
        <div class="shot-panel">
          <div class="seg" style="display:flex"><button style="flex:1;justify-content:center">Battery</button><button aria-selected="true" style="flex:1;justify-content:center">GPS</button><button style="flex:1;justify-content:center">Network</button></div>
          <div class="map" style="height:150px"><svg viewBox="0 0 300 176" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="300" height="176" fill="var(--jidr-color-surface-control)"/><path d="M0 0H300V40C250 50 210 32 160 42S70 56 0 46Z" fill="var(--jidr-status-transition-container)"/><path d="M0 96H300M70 46V176M160 42V176M240 36V176M0 140L300 120" stroke="var(--jidr-color-surface-raised)" stroke-width="6" fill="none"/><path d="M160 96L200 124 236 128 270 176" stroke="var(--jidr-color-accent-fill)" stroke-width="2.5" stroke-dasharray="5 4" fill="none"/><circle cx="160" cy="96" r="6" fill="var(--jidr-color-accent-fill)"/></svg><span class="attr">© OpenStreetMap contributors</span></div>
          <span class="num" style="font-size:12px">32.8954, 13.1802</span>
          <div class="routecard"><span class="num" style="font-size:12px">tripoli-airport-run.gpx · 2×</span><div class="bar"><i style="width:38%;background:var(--jidr-color-accent-fill)"></i></div></div>
        </div>
      </div>
    </div>
