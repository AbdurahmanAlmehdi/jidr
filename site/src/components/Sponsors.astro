---
// From docs/design/screens/Landing.dc.html (D41). The sponsor logo slots are
// left out until there are sponsors to show.
import { links } from "../config";
---

<section class="lp-sec">
  <div class="sponsorband">
    <h2 class="lp-h2" style="font-size:28px;line-height:34px">Sponsors keep Jidr free</h2>
    <p class="lead">Jidr has no paid tier and no accounts. Sponsorship pays for the work.</p>
    <div class="j-row" style="flex-wrap:wrap">
      <a class="btn" href={links.sponsors}><svg class="ic i16" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>Sponsor Jidr</a>
      <a class="btn btn-primary" href={links.repo}>Star on GitHub</a>
    </div>
  </div>
</section>
