// SPDX-License-Identifier: GPL-3.0-only
// System CA certificates (Full root): the certificates Jidr added to the
// device's system store, for Burp or mitmproxy, in the widget panel's
// Developer tools under the build identity. Same rows as `PropsBlock` (label +
// small buttons, 11 px hints), mirrored by hand for RTL. `RootDevTools` binds
// it to `RootUi`; Rust (`src/root/cacerts/mod.rs`) fills it.

import { Theme } from "../../../ui/theme.slint";
import { Icons } from "../../../ui/icons.slint";
import { T, Tone, Tag, Button, ButtonKind } from "../../../ui/components/base.slint";

export struct CertRow {
    /// The store file name, `a4ac454c.0`.
    file: string,
    /// Common name, e.g. "PortSwigger CA".
    subject: string,
    /// In the store apps read (false until the restart after adding it).
    trusted: bool,
}

export component CertsBlock inherits VerticalLayout {
    in property <[CertRow]> certs;
    in property <bool> running;
    in property <bool> busy;
    /// An add or remove is under way (it restarts the device).
    in property <bool> working;
    /// What the add/remove is doing, or why it failed.
    in property <string> status;
    in property <bool> failed;
    /// "add", "" | "remove", file.
    callback action(string, string);

    spacing: 8px;
    accessible-role: groupbox;
    accessible-label: @tr("CA certificates");

    // "CA certificates" + [Add…] on the end edge.
    Rectangle {
        height: 20px;
        T {
            x: Theme.rtl ? parent.width - self.width : 0px;
            width: min(self.preferred-width, parent.width - 90px);
            text: @tr("CA certificates");
        }
        Button {
            x: Theme.rtl ? 0px : parent.width - self.width;
            y: (parent.height - self.height) / 2;
            small: true;
            kind: ButtonKind.tertiary;
            has-icon: true;
            icon: Icons.plus;
            enabled: running && !busy && !working;
            text: @tr("Add…");
            clicked => { root.action("add", ""); }
        }
    }

    for c in certs: Rectangle {
        height: 36px;
        T {
            x: Theme.rtl ? 80px : 0px;
            y: 0px;
            width: parent.width - 80px - (tag.width + 8px);
            height: 18px;
            overflow: elide;
            horizontal-alignment: Theme.rtl ? right : left;
            text: c.subject;
        }
        tag := Tag {
            x: Theme.rtl ? parent.width - self.width : parent.width - 80px - self.width - 4px;
            y: 0px;
            tone: c.trusted ? Tone.positive : Tone.warning;
            text: c.trusted ? @tr("Trusted") : @tr("After restart");
        }
        T {
            x: Theme.rtl ? 80px : 0px;
            y: 19px;
            width: parent.width - 80px;
            height: 15px;
            font-size: 11px;
            font-family: Theme.font-mono;
            color: Theme.text-tertiary;
            horizontal-alignment: Theme.rtl ? right : left;
            text: c.file;
        }
        Button {
            x: Theme.rtl ? 0px : parent.width - self.width;
            y: 2px;
            small: true;
            kind: ButtonKind.tertiary;
            has-icon: true;
            icon: Icons.trash-2;
            enabled: running && !busy && !working;
            text: @tr("Remove");
            clicked => { root.action("remove", c.file); }
        }
    }

    // Wrapped text reports a one-line preferred height in a layout, so
    // these get room for two lines.
    T {
        height: 30px;
        font-size: 11px;
        color: failed ? Theme.negative : Theme.text-tertiary;
        wrap: word-wrap;
        overflow: clip;
        vertical-alignment: top;
        horizontal-alignment: Theme.rtl ? right : left;
        text: status != "" ? status
            : !running ? @tr("Start the device to add or remove CA certificates.")
            : certs.length == 0 ? @tr("Trust Burp's or mitmproxy's CA as a system certificate. Adding one restarts the device.")
            : @tr("Apps trust these as system certificates. Adding or removing one restarts the device.");
    }
}
