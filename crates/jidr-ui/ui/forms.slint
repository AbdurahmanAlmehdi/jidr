// Form building blocks: Select, root-mode cards, image list, sheet.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { T, Role, Tone, Tones, Icon, Button, ButtonKind, Tag, Hint, FieldLabel, Pill } from "components/base.slint";
import { ImageRowVm, OptionVm, ExhaustedRow } from "types.slint";

/// Dropdown (`Select` spec): shows the current option, opens a menu.
export component Select inherits Rectangle {
    in property <[OptionVm]> options;
    in-out property <int> selected;
    in property <string> trailing;
    callback changed(int);
    height: Theme.control-height-md;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: ta.has-hover ? Theme.surface-control-hover : Theme.surface-control;
    T {
        x: Theme.rtl ? 30px : 10px;
        width: parent.width - 40px - (root.trailing != "" ? tr.preferred-width + 8px : 0px);
        text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected].label : "";
    }
    tr := T {
        visible: root.trailing != "";
        x: Theme.rtl ? 30px : parent.width - 30px - self.preferred-width;
        width: self.preferred-width;
        text: root.trailing;
        role: Role.caption;
        color: Theme.text-secondary;
    }
    Icon {
        x: Theme.rtl ? 10px : parent.width - 10px - self.width;
        size: Theme.icon-sm;
        source: Icons.chevron-down;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.surface-overlay;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-default;
            drop-shadow-offset-y: Theme.elevation-2-shadow-y;
            drop-shadow-blur: Theme.elevation-2-shadow-blur;
            drop-shadow-color: Theme.elevation-2-shadow-color;
            VerticalLayout {
                padding: 4px;
                for o[i] in root.options: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: ita.has-hover ? Theme.surface-selected : transparent;
                    T {
                        x: Theme.rtl ? 28px : 10px;
                        width: parent.width - 38px;
                        text: o.label;
                    }
                    if i == root.selected: Icon {
                        x: Theme.rtl ? 8px : parent.width - 8px - self.width;
                        size: Theme.icon-sm;
                        source: Icons.check;
                    }
                    ita := TouchArea {
                        clicked => {
                            root.selected = i;
                            root.changed(i);
                        }
                    }
                }
            }
        }
    }
}

/// Android version list (`.imglist`): host-ABI images with their state.
export component ImageList inherits Rectangle {
    in property <[ImageRowVm]> images;
    in-out property <int> selected;
    callback changed(int);
    height: min(6, images.length) * 32px + 2px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: Theme.surface-control;
    clip: true;
    Flickable {
        y: 1px;
        height: parent.height - 2px;
        content-height: root.images.length * 32px;
        for img[i] in root.images: Rectangle {
            y: i * 32px;
            height: 32px;
            background: i == root.selected ? Theme.accent-container : transparent;
            if i > 0: Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.border-subtle;
            }
            Rectangle {
                x: Theme.rtl ? parent.width - 26px : 10px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: i == root.selected ? 5px : 1px;
                border-color: i == root.selected ? Theme.accent-fill : Theme.border-strong;
                background: i == root.selected ? Theme.text-on-accent : Theme.surface-control;
                visible: img.enabled;
            }
            if !img.enabled: Icon {
                x: Theme.rtl ? parent.width - 26px : 10px;
                size: 16px;
                source: Icons.download;
                colorize: Theme.text-disabled;
            }
            T {
                x: Theme.rtl ? st.preferred-width + 20px : 36px;
                width: parent.width - 56px - st.preferred-width;
                text: img.label;
                color: img.enabled ? Theme.text-primary : Theme.text-disabled;
            }
            st := T {
                x: Theme.rtl ? 10px : parent.width - 10px - self.preferred-width;
                width: self.preferred-width;
                text: img.status;
                font-size: 12px;
                color: Theme.text-secondary;
            }
            TouchArea {
                enabled: img.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

/// Label above a control.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 5px;
    FieldLabel { text: root.label; height: 16px; }
    @children
    if root.hint != "": Hint { text: root.hint; height: 15px; }
}

/// Sheet over a scrim (`.scrim` + `.sheet`), dropped from the title bar.
export component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> sheet-width: 680px;
    in property <length> body-height: 400px;
    callback dismiss();
    background: Theme.scrim;
    TouchArea { clicked => { root.dismiss(); } }
    sheet := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: root.sheet-width;
        height: 72px + root.body-height + 56px;
        background: Theme.elevation-3-surface;
        border-width: 1px;
        border-color: Theme.border-default;
        border-radius: Theme.radius-xl;
        drop-shadow-offset-y: Theme.elevation-3-shadow-y;
        drop-shadow-blur: Theme.elevation-3-shadow-blur;
        drop-shadow-color: Theme.elevation-3-shadow-color;
        clip: true;
        TouchArea {}
        T {
            x: 20px;
            y: 18px;
            width: parent.width - 40px;
            height: 20px;
            text: root.title;
            font-size: 15px;
            font-weight: 600;
        }
        T {
            x: 20px;
            y: 42px;
            width: parent.width - 40px;
            height: 17px;
            text: root.subtitle;
            font-size: 12px;
            color: Theme.text-secondary;
        }
        // Body and footer: children lay out the body in the top `body-height`
        // and put a `SheetFooter` at `y: root.body-height` (inside children,
        // `parent` is the sheet's root, not this container).
        Rectangle {
            x: 0px;
            y: 72px;
            width: root.sheet-width;
            height: root.body-height + 56px;
            @children
        }
    }
}

/// Sheet footer bar (`.sf`); place at `Sheet.footer-y`.
export component SheetFooter inherits Rectangle {
    height: 56px;
    background: Theme.surface-chrome;
    border-radius: Theme.radius-xl;
    Rectangle {
        y: 0px;
        height: 14px;
        background: Theme.surface-chrome;
    }
    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.border-default;
    }
    @children
}

/// Alert dialog (`.sheet.w-dialog`): what happens, whether data is safe.
export component ConfirmDialog inherits Sheet {
    in property <string> body;
    in property <string> action;
    in property <bool> destructive: true;
    callback ok();
    callback cancel();
    sheet-width: 440px;
    body-height: 64px;
    dismiss => { root.cancel(); }
    T {
        x: 20px;
        y: 0px;
        width: root.sheet-width - 40px;
        height: 56px;
        text: root.body;
        color: Theme.text-secondary;
        wrap: word-wrap;
        vertical-alignment: top;
    }
    SheetFooter {
        y: root.body-height;
        width: root.sheet-width;
        HorizontalLayout {
            x: Theme.rtl ? 20px : parent.width - 20px - self.preferred-width;
            width: self.preferred-width;
            height: 30px;
            spacing: 8px;
            Button {
                text: @tr("Cancel");
                clicked => { root.cancel(); }
            }
            Button {
                kind: root.destructive ? ButtonKind.destructive : ButtonKind.primary;
                text: root.action;
                clicked => { root.ok(); }
            }
        }
    }
}

/// "Not enough RAM" (`resource_exhausted`, D42): what the start needs, the
/// idle devices that would make room, and the ways forward.
export component ExhaustedDialog inherits Sheet {
    in property <string> device-name;
    in property <string> need;
    in property <string> free;
    in property <string> budget;
    in property <[ExhaustedRow]> rows;
    /// How many rows are picked to hibernate (0: hibernating can't make room).
    in property <int> picks;
    in property <string> first-pick;
    callback hibernate();
    callback force();
    callback cancel();
    title: @tr("Not enough RAM to start {}", device-name);
    subtitle: @tr("It needs about {}, and {} of the {} RAM budget is free.", need, free, budget);
    sheet-width: 520px;
    property <length> cw: root.sheet-width - 40px;
    property <length> list-h: rows.length > 0 ? 22px + rows.length * 34px + 2px : 40px;
    body-height: list-h + 52px;
    dismiss => { root.cancel(); }

    if rows.length > 0: FieldLabel {
        x: Theme.rtl ? 20px + cw - self.preferred-width : 20px;
        y: 0px;
        width: self.preferred-width;
        height: 16px;
        text: @tr("Running devices, longest idle first");
    }
    if rows.length > 0: Rectangle {
        x: 20px;
        y: 22px;
        width: cw;
        height: root.rows.length * 34px + 2px;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-default;
        background: Theme.surface-raised;
        clip: true;
        for r[i] in root.rows: Rectangle {
            y: 1px + i * 34px;
            height: 34px;
            if i > 0: Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border-subtle;
            }
            Icon {
                x: Theme.rtl ? parent.width - 12px - self.width : 12px;
                size: Theme.icon-sm;
                source: Icons.smartphone;
            }
            name := T {
                x: Theme.rtl ? parent.width - 34px - self.width : 34px;
                width: min(self.preferred-width, parent.width - 230px);
                text: r.name;
                role: Role.label;
                font-weight: 600;
            }
            if r.picked: Tag {
                x: Theme.rtl ? name.x - 8px - self.width : name.x + name.width + 8px;
                tone: Tone.neutral;
                text: @tr("Hibernates");
            }
            T {
                x: Theme.rtl ? 12px : parent.width - 12px - self.width;
                width: self.preferred-width;
                text: r.detail;
                role: Role.caption;
                color: Theme.text-secondary;
            }
        }
    }
    if rows.length == 0: T {
        x: 20px;
        y: 0px;
        width: cw;
        height: 40px;
        text: @tr("No running device has sat idle. Stop one in the Library, or start anyway.");
        color: Theme.text-secondary;
        wrap: word-wrap;
        vertical-alignment: top;
    }
    Hint {
        x: 20px;
        y: list-h + 8px;
        width: cw;
        height: 30px;
        text: @tr("Hibernating saves a device's whole state; Resume brings it back in seconds. Starting anyway can make the Mac swap and slow down.");
    }
    SheetFooter {
        y: root.body-height;
        width: root.sheet-width;
        HorizontalLayout {
            x: Theme.rtl ? 20px : parent.width - 20px - self.preferred-width;
            width: self.preferred-width;
            height: 30px;
            spacing: 8px;
            property <int> n: root.picks > 0 ? 3 : 2;
            for slot[j] in n: Rectangle {
                property <int> i: Theme.rtl ? n - 1 - j : j;
                width: i == 0 ? cancel-b.width : i == 1 ? force-b.width : go-b.width;
                cancel-b := Button {
                    visible: i == 0;
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                force-b := Button {
                    visible: i == 1;
                    text: @tr("Start anyway");
                    clicked => { root.force(); }
                }
                go-b := Button {
                    visible: i == 2;
                    kind: ButtonKind.primary;
                    text: root.picks == 1 ? @tr("Hibernate {} and start", root.first-pick) : @tr("Hibernate {} devices and start", root.picks);
                    clicked => { root.hibernate(); }
                }
            }
        }
    }
}
