// View models shared by Rust and Slint. Labels are computed in Rust
// (crates/jidr-ui/src/model.rs) so the UI holds no business logic.

/// Device status as the user sees it (PRODUCT.md §5).
export enum DevState { stopped, starting, booting, running, paused, stopping, crashed, busy }

/// Root badge state (RootBadge spec).
export enum RootKind { none, shell, full, setting-up, verified, unverified, failed }

export enum FormFactor { phone, small-phone, tablet }

export enum JobTone { queued, running, done, failed, cancelled }

export struct DeviceVm {
    id: string,
    name: string,
    /// "Phone 6.1″ FHD+"
    profile: string,
    /// "1080×2400 · 420 dpi"
    screen: string,
    /// "Android 15 · API 35"
    android: string,
    /// "Google APIs"
    image: string,
    state: DevState,
    /// "Running · 2 h 14 m", "Booting Android… 62%", "Busy · in use by CLI"
    status: string,
    /// Boot progress 0..1 while booting.
    progress: float,
    root: RootKind,
    /// "Rooted · Magisk 30.7", "Shell root (adb)", "Full root"
    root-label: string,
    /// Sidebar form: "Rooted", "Shell", "Full", "No root"
    root-short: string,
    /// Play Store image with Full root.
    beta: bool,
    /// "Full root", "Shell root", "Not rooted" (health panel mode line).
    root-mode: string,
    magisk: string,
    /// "2 min ago · su -c id → uid=0"
    verified: string,
    serial: string,
    disk: string,
    ram: string,
    cpus: string,
    uptime: string,
    last-started: string,
    form: FormFactor,
    width-px: int,
    height-px: int,
    play-store: bool,
}

export struct JobVm {
    id: string,
    /// "Android 16 (API 36) image"
    title: string,
    tone: JobTone,
    progress: float,
    indeterminate: bool,
    /// "1.4 / 2.1 GB"
    detail: string,
    /// "2 min left"
    eta: string,
    cancellable: bool,
}

export struct TabVm {
    id: string,
    name: string,
    state: DevState,
}

export struct SnapshotVm {
    name: string,
    /// "Taken with: Full root"
    tag: string,
    root: RootKind,
    auto: bool,
    size: string,
    when: string,
    /// Restoring is refused under the device's current root mode (D29).
    refused: bool,
    thumb: image,
    has-thumb: bool,
}

export enum ConnState { connecting, online, reconnecting, offline }
